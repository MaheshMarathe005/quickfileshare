# ---- Server ----
PORT=3000
# Base URL used when generating share links (no trailing slash)
BASE_URL=http://localhost:3000

# A long random secret used to hash share codes. CHANGE THIS.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me-to-a-long-random-string

# Optional dedicated key for at-rest file encryption. If blank, APP_SECRET is used.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ---- Share behaviour ----
# Storage backend (where file BYTES live): "local" (disk) or "gdrive" (Google Drive)
STORAGE_BACKEND=local
# Metadata store (where share RECORDS live): "file" (JSON on disk) or "redis" (Upstash).
# Use "redis" for serverless/multi-instance (Vercel); "file" for a single persistent server.
STORE_BACKEND=file
# Code style: "code" (8-char, secure) or "digits" (6-digit numeric, less secure)
CODE_STYLE=code
# Hours until a share expires and is auto-deleted
SHARE_TTL_HOURS=24
# Extra hours a share's metadata lingers past expiry so the cron sweep can still delete
# its blobs from Drive (redis store only). Default 2.
SHARE_GRACE_HOURS=2
# Max size of a single file (bytes). Default 15 MB.
MAX_FILE_BYTES=15728640
# Max total upload size per share (bytes). Default 60 MB.
MAX_UPLOAD_BYTES=62914560
# Max number of downloads per share (0 = unlimited until expiry)
MAX_DOWNLOADS=0
# Max failed code attempts per IP (per 5 min) before rate-limiting
MAX_ATTEMPTS=10

# ---- Google Drive (only needed when STORAGE_BACKEND=gdrive) ----
# From your Google Cloud OAuth 2.0 Client (Desktop app type)
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
# Obtained by running:  npm run gdrive-auth
GDRIVE_REFRESH_TOKEN=
# Optional: an existing Drive folder ID to use as the app root. Blank = auto-create "mahesh_fs uploads".
GDRIVE_FOLDER_ID=
# Reserve this many bytes of your Drive quota for personal use; the app stops before
# using it. Default 100 GB. Example: 100 GB = 107374182400
DRIVE_RESERVE_BYTES=107374182400

# ---- Serverless (Vercel) — only needed when STORE_BACKEND=redis ----
# Upstash Redis REST credentials (from the Upstash console, or auto-injected by the
# Vercel Upstash/KV integration as KV_REST_API_URL / KV_REST_API_TOKEN — both are read).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Shared secret the Vercel Cron sweep must send. Generate like APP_SECRET above.
# Vercel automatically sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
